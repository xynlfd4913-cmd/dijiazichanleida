# API (RADAR_DATABASE_URL wins; DATABASE_URL is a compatible fallback.)
RADAR_DATABASE_URL=sqlite+pysqlite:///./data/debt_asset_radar.db
DATABASE_URL=sqlite+pysqlite:///./data/debt_asset_radar.db
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
SEED_ON_START=true

# Web (copy this value to apps/web/.env.local for direct npm runs.)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
API_INTERNAL_BASE_URL=http://localhost:8000/api

# Reserved for Phase 1. Phase 0 never enables real sources, even if this value changes.
ENABLE_REAL_SOURCES=false
